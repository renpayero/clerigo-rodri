---
import Base from '@/layouts/Base.astro';
import { actions, isInputError } from 'astro:actions';

if (Astro.locals.session) return Astro.redirect('/');

const result = Astro.getActionResult(actions.auth.login);
if (result && !result.error) {
  return Astro.redirect(result.data.next ?? '/');
}
const guestResult = Astro.getActionResult(actions.auth.guest);
if (guestResult && !guestResult.error) {
  return Astro.redirect(guestResult.data.next ?? '/');
}
const next = Astro.url.searchParams.get('next') ?? '/';
let message: string | null = null;
if (result?.error) {
  message = isInputError(result.error) ? 'Ingresá la contraseña.' : result.error.message;
}
---

<Base title="Entrar">
  <main class="login">
    <form method="POST" action={actions.auth.login} class="card stack">
      <div>
        <h1>Rodri</h1>
        <p class="muted">Cleric 11 · Mythic Hierophant 3 · ayuda de juego</p>
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required autofocus />
      </div>
      <input type="hidden" name="next" value={next} />
      {message && <p class="error" role="alert">{message}</p>}
      <button class="btn btn--primary" type="submit">Entrar</button>
    </form>
    <form method="POST" action={actions.auth.guest} class="guest">
      <input type="hidden" name="next" value={next} />
      <button class="btn btn--ghost" type="submit">Entrar como invitado</button>
      <p class="help">Para los compañeros de mesa: ven todo, no pueden cambiar nada.</p>
    </form>
  </main>
</Base>

<style>
  .login { min-height: 100dvh; display: grid; align-content: center; justify-items: center; gap: var(--s3); padding: var(--s4); }
  form { width: min(380px, 100%); }
  .guest { text-align: center; display: grid; gap: var(--s2); justify-items: center; margin-top: var(--s3); }
</style>
