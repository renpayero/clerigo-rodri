---
import { actions } from 'astro:actions';

// Destino del formulario "Salir" (banner de invitado y Ajustes): cierra la sesión y manda al login.
const result = Astro.getActionResult(actions.auth.logout);
if (result && !result.error) return Astro.redirect('/login');
return Astro.redirect('/');
