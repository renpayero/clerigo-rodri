---
import App from '@/layouts/App.astro';
import { getCollection, getEntry, render } from 'astro:content';

const { slug } = Astro.params;
const entry = slug ? await getEntry('rules', slug) : undefined;
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);
const all = (await getCollection('rules')).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((e) => e.id === entry.id);
const prev = all[i - 1];
const next = all[i + 1];
---

<App title={entry.data.title} description={entry.data.summary}>
  <article class="card prose rule">
    <p class="section-title">{entry.data.section} · <a href="/reglas">todas las reglas</a></p>
    <h1>{entry.data.title}</h1>
    <p class="muted">{entry.data.summary}</p>
    <Content />
    <p class="tags">{entry.data.tags.map((t) => <span class="badge">{t}</span>)}</p>
  </article>
  <nav class="rule-nav">
    {prev ? <a class="btn" href={`/reglas/${prev.id}`}>← {prev.data.title}</a> : <span />}
    {next ? <a class="btn" href={`/reglas/${next.id}`}>{next.data.title} →</a> : <span />}
  </nav>
</App>

<script>
  // Links externos (AoN, paizo) en pestaña nueva.
  document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((a) => {
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
  });
</script>

<style>
  .rule h1 { font-size: var(--fs-6); margin: var(--s2) 0; line-height: var(--lh-tight); }
  .rule .tags { display: flex; gap: var(--s1); flex-wrap: wrap; margin-top: var(--s4); }
  .rule-nav { display: flex; justify-content: space-between; gap: var(--s3); margin-top: var(--s4); flex-wrap: wrap; }
  .rule-nav .btn { max-width: 100%; white-space: normal; text-align: left; }
</style>
